@model UserRegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kayıt Ol — Postane</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
            /* =========================================================
                           TEMA DEĞİŞKENLERİ — Default.cshtml / Login.cshtml ile aynı palet
                           ========================================================= */
            :root {
                --app-bg: #F8FAFA;
                --surface: #FFFFFF;
                --sidebar-bg: #263238;
                --sidebar-bg-2: #1E282D;
                --border: #E2E8E8;
                --text: #1F2937;
                --text-muted: #64748B;
                --on-sidebar: rgba(255, 255, 255, .82);
                --on-sidebar-muted: rgba(255, 255, 255, .5);
                --on-sidebar-faint: rgba(255, 255, 255, .09);
                --primary: #0D9488;
                --primary-strong: #0F766E;
                --primary-rgb: 13, 148, 136;
                --primary-soft: #CCFBF1;
                --primary-tint: #F0FDFA;
                --radius: 8px;
                --radius-sm: 6px;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
                color: var(--text);
                background: var(--surface);
                -webkit-font-smoothing: antialiased;
            }

            a {
                color: inherit;
            }

            /* =========================================================
                           AUTH KABUĞU — sol marka paneli + sağ form paneli
                           ========================================================= */
            .auth-shell {
                display: grid;
                grid-template-columns: minmax(360px, 42%) 1fr;
                min-height: 100vh;
            }

            /* ---- Sol panel: marka ---- */
            .auth-brand-panel {
                position: relative;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 40px 48px;
                background: linear-gradient(145deg, var(--sidebar-bg) 0%, var(--sidebar-bg-2) 100%);
                color: var(--on-sidebar);
                overflow: hidden;
            }

            .auth-brand {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .auth-brand-name {
                font-size: 17px;
                font-weight: 700;
                letter-spacing: -0.02em;
                line-height: 1.1;
                color: #FFFFFF;
            }

            .auth-brand-tagline {
                display: block;
                font-size: 11px;
                font-weight: 500;
                color: var(--on-sidebar-muted);
            }

            .auth-brand-body {
                max-width: 380px;
            }

            .auth-brand-heading {
                margin: 0 0 12px;
                font-size: 28px;
                font-weight: 700;
                line-height: 1.3;
                letter-spacing: -0.01em;
                color: #FFFFFF;
            }

            .auth-brand-sub {
                margin: 0;
                font-size: 14px;
                line-height: 1.6;
                color: var(--on-sidebar-muted);
            }

            .auth-feature-list {
                list-style: none;
                margin: 28px 0 0;
                padding: 0;
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

            .auth-feature {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                font-size: 13px;
                line-height: 1.4;
                color: var(--on-sidebar);
            }

            .auth-feature i {
                flex-shrink: 0;
                width: 28px;
                height: 28px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: var(--radius-sm);
                background: var(--on-sidebar-faint);
                color: var(--primary-soft);
                font-size: 14px;
            }

            .auth-brand-footer {
                font-size: 12px;
                color: var(--on-sidebar-muted);
            }

            .auth-brand-footer a {
                color: var(--on-sidebar);
                text-decoration: underline;
                text-underline-offset: 2px;
            }

            /* ---- Sağ panel: form ---- */
            .auth-form-panel {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 32px;
            }

            .auth-form-wrap {
                width: 100%;
                max-width: 360px;
            }

            .auth-heading {
                margin: 0 0 6px;
                font-size: 24px;
                font-weight: 700;
                letter-spacing: -0.01em;
            }

            .auth-subtext {
                margin: 0 0 28px;
                font-size: 14px;
                color: var(--text-muted);
            }

            .auth-field {
                margin-bottom: 16px;
            }

            .auth-field-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .auth-field label {
                display: block;
                margin-bottom: 6px;
                font-size: 13px;
                font-weight: 600;
                color: var(--text);
            }

            .auth-input-group {
                position: relative;
            }

            .auth-input-group i.auth-input-icon {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 14px;
                color: var(--text-muted);
                pointer-events: none;
            }

            .auth-input-group input {
                width: 100%;
                height: 44px;
                padding: 0 14px 0 38px;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                font-size: 14px;
                font-family: inherit;
                color: var(--text);
                background: var(--surface);
                transition: border-color .15s, box-shadow .15s;
            }

            .auth-input-group input::placeholder {
                color: #9CA7AF;
            }

            .auth-input-group input:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(var(--primary-rgb), .12);
            }

            .auth-input-group input[type="password"],
            .auth-input-group input.has-toggle {
                padding-right: 42px;
            }

            .auth-toggle-visibility {
                position: absolute;
                right: 6px;
                top: 50%;
                transform: translateY(-50%);
                width: 30px;
                height: 30px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 0;
                background: transparent;
                border-radius: var(--radius-sm);
                color: var(--text-muted);
                font-size: 14px;
                transition: background-color .15s, color .15s;
            }

            .auth-toggle-visibility:hover {
                background: var(--app-bg);
                color: var(--text);
            }

            .auth-terms {
                display: flex;
                align-items: flex-start;
                gap: 8px;
                margin: 20px 0 22px;
                font-size: 13px;
                line-height: 1.5;
                color: var(--text);
            }

            .auth-terms .form-check-input {
                margin-top: 2px;
                flex-shrink: 0;
            }

            .auth-terms a {
                font-weight: 600;
                color: var(--primary-strong);
                text-decoration: none;
            }

            .auth-terms a:hover {
                text-decoration: underline;
            }

            .btn-auth-primary {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                height: 44px;
                border: 0;
                border-radius: var(--radius);
                background: var(--primary);
                color: #fff;
                font-weight: 600;
                font-size: 14px;
                font-family: inherit;
                transition: background-color .15s, transform .12s ease;
            }

            .btn-auth-primary:hover {
                background: var(--primary-strong);
                color: #fff;
            }

            .btn-auth-primary:active {
                transform: scale(0.98);
            }

            .auth-switch {
                margin-top: 24px;
                font-size: 13px;
                color: var(--text-muted);
                text-align: center;
            }

            .auth-switch a {
                font-weight: 600;
                color: var(--primary-strong);
                text-decoration: none;
            }

            .auth-switch a:hover {
                text-decoration: underline;
            }

            /* =========================================================
                           RESPONSIVE
                           ========================================================= */
            @@media (max-width: 991.98px) {
                .auth-shell {
                    display: block;
                }

                .auth-brand-panel {
                    padding: 24px 28px;
                }

                .auth-brand-body,
                .auth-feature-list,
                .auth-brand-footer {
                    display: none;
                }

                .auth-form-panel {
                    padding: 36px 24px 48px;
                }
            }

            @@media (max-width: 575.98px) {
                .auth-brand-panel {
                    padding: 20px 20px;
                }

                .auth-form-panel {
                    padding: 28px 16px 40px;
                }

                .auth-field-row {
                    grid-template-columns: 1fr;
                    gap: 0;
                }
            }
    </style>
</head>

<body>

    <div class="auth-shell">

        <!-- Sol: marka paneli -->
        <aside class="auth-brand-panel">
            <div class="auth-brand">
                <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
                    <rect width="32" height="32" rx="8" style="fill: var(--primary);" />
                    <rect x="7.5" y="10" width="17" height="12.5" rx="2" fill="none" stroke="#FFFFFF"
                          stroke-width="1.8" />
                    <path d="M8.5 11.5 L16 17 L23.5 11.5" fill="none" stroke="#FFFFFF" stroke-width="1.8"
                          stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="24.5" cy="9.5" r="3.5" style="fill: var(--primary-soft); stroke: var(--primary-strong);"
                            stroke-width="1.5" />
                </svg>
                <div class="auth-brand-name">
                    Postane
                    <span class="auth-brand-tagline">Kurumsal E-posta</span>
                </div>
            </div>

            <div class="auth-brand-body">
                <h1 class="auth-brand-heading">Ekibinizi Postane'ye birkaç dakikada taşıyın.</h1>
                <p class="auth-brand-sub">Kurumsal e-posta adresinizle hesabınızı oluşturun, yöneticiniz onayladığında
                    ekibinize katılın.</p>

                    <ul class="auth-feature-list">
                        <li class="auth-feature">
                            <i class="bi bi-shield-lock"></i>
                            <span>Kurumsal kimlik doğrulama ile korunur</span>
                        </li>
                        <li class="auth-feature">
                            <i class="bi bi-people"></i>
                            <span>Departmanlar için ortak gelen kutuları</span>
                        </li>
                        <li class="auth-feature">
                            <i class="bi bi-hdd"></i>
                            <span>Kullanıcı başına 10 GB depolama alanı</span>
                        </li>
                    </ul>
                </div>

                <div class="auth-brand-footer">
                    Yardıma mı ihtiyacınız var? <a href="mailto:destek@postane.com">destek@postane.com</a>
                </div>
            </aside>

            <!-- Sağ: form paneli -->
            <main class="auth-form-panel">
                <div class="auth-form-wrap">

                    <h2 class="auth-heading">Hesap oluştur</h2>
                    <p class="auth-subtext">Kurumsal e-posta adresinizle birkaç adımda başlayın.</p>

                    <form asp-controller="Register" asp-action="SignUp" method="post">

                        <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

                        <div class="auth-field-row">
                            <div class="auth-field">
                                <label asp-for="Name">Ad</label>
                                <div class="auth-input-group">
                                    <i class="bi bi-person auth-input-icon"></i>
                                    <input asp-for="Name" class="form-control" placeholder="Ahmet"
                                           autocomplete="given-name">
                                </div>
                                <span asp-validation-for="Name" class="auth-field-error"></span>
                            </div>

                            <div class="auth-field">
                                <label asp-for="Surname">Soyad</label>
                                <div class="auth-input-group">
                                    <i class="bi bi-person auth-input-icon"></i>
                                    <input asp-for="Surname" class="form-control" placeholder="Yılmaz"
                                           autocomplete="family-name">
                                </div>
                                <span asp-validation-for="Surname" class="auth-field-error"></span>
                            </div>
                        </div>

                        <div class="auth-field">
                            <label asp-for="Email">Kurumsal e-posta</label>
                            <div class="auth-input-group">
                                <i class="bi bi-envelope auth-input-icon"></i>
                                <input asp-for="Email" class="form-control" placeholder="ad.soyad@sirket.com"
                                       autocomplete="username">
                            </div>
                            <span asp-validation-for="Email" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field-row">
                            <div class="auth-field">
                                <label asp-for="Password">Şifre</label>
                                <div class="auth-input-group">
                                    <i class="bi bi-lock auth-input-icon"></i>
                                    <input asp-for="Password" class="form-control has-toggle" placeholder="••••••••"
                                           autocomplete="new-password">
                                    <button type="button" class="auth-toggle-visibility" data-toggle-for="Password"
                                            aria-label="Şifreyi göster">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="auth-field-error"></span>
                            </div>

                            <div class="auth-field">
                                <label asp-for="ConfirmPassword">Şifre tekrar</label>
                                <div class="auth-input-group">
                                    <i class="bi bi-lock auth-input-icon"></i>
                                    <input asp-for="ConfirmPassword" class="form-control has-toggle" placeholder="••••••••"
                                           autocomplete="new-password">
                                    <button type="button" class="auth-toggle-visibility" data-toggle-for="ConfirmPassword"
                                            aria-label="Şifreyi göster">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn-auth-primary">Hesap oluştur</button>
                    </form>

                    <p class="auth-switch">Zaten bir hesabınız var mı? <a asp-controller="Login" asp-action="SignIn">Giriş
                        yapın</a></p>
                    </div>
                </main>

            </div>

            <script>
                    /* Şifre alanlarını göster/gizle — her toggle butonu kendi inputunu data-toggle-for ile bulur */
                    document.querySelectorAll('.auth-toggle-visibility').forEach(function (button) {
                        button.addEventListener('click', function () {
                            const input = document.getElementById(button.dataset.toggleFor);
                            const icon = button.querySelector('i');
                            const isHidden = input.type === 'password';

                            input.type = isHidden ? 'text' : 'password';
                            icon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
                            button.setAttribute('aria-label', isHidden ? 'Şifreyi gizle' : 'Şifreyi göster');
                        });
                    });
            </script>
        </body>

    </html>